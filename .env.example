# PostgreSQL connection string used by Drizzle ORM (src/db/index.ts)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lingoquest

# Bí mật ký session cookie (HMAC-SHA256). Đổi thành chuỗi dài ngẫu nhiên ở production.
# Nếu thiếu, app dùng giá trị dev không an toàn (chỉ chạy local).
SESSION_SECRET=change-me-in-production

# ---- Tài khoản demo (auth thật qua bảng users Postgres) ----
# Học sinh : minh.nguyen@lingoquest.app / Pass1234
# Giáo viên: lan.le@lingoquest.app     / Pass1234
# (mật khẩu được seed tự động bởi seedIfEmpty)

# ---- Google OAuth2 (PKCE, KHÔNG thêm dependency) ----
# Tạo tại https://console.cloud.google.com/apis/credentials
# Authorized redirect URI phải là: <ORIGIN>/api/auth/google/callback
# Ví dụ local: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=469212637499-1troft79e7ieoibofo12i77j9hqdt5m1.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
# Nếu để trống, app tự suy ra từ origin (http://localhost:3000/api/auth/google/callback).
GOOGLE_REDIRECT_URI=
