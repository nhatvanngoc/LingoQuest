@import "tailwindcss";

/* ===========================================================
   LingoQuest — Design System (Tailwind v4 @theme tokens)
   Light mode trước. Tone: sạch, phẳng, thân thiện, chuyên nghiệp.
   =========================================================== */
@theme {
  /* Font hiển thị chính — Nunito (bo tròn, hỗ trợ tiếng Việt tốt).
     next/font nạp font và gán vào biến --font-nunito (xem layout.tsx). */
  --font-sans: var(--font-nunito), ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;

  /* Màu nền chính: trắng kem */
  --color-cream: #f8fafc;
  --color-ink: #0f172a; /* slate-900 — chữ chính */

  /* Màu thương hiệu (primary) — xanh dương blue-600 */
  --color-brand: #2563eb;
  --color-brand-50: #eff6ff;
  --color-brand-100: #dbeafe;
  --color-brand-600: #2563eb;
  --color-brand-700: #1d4ed8;

  /* Màu phụ — xanh lá nhạt (đúng / hoàn thành) */
  --color-success: #10b981;
  --color-success-50: #ecfdf5;
  --color-success-100: #d1fae5;

  /* Màu nhấn năng lượng — vàng (streak, XP, huy hiệu) */
  --color-accent: #fbbf24;
  --color-accent-50: #fffbeb;
  --color-accent-100: #fef3c7;

  /* Màu cảnh báo — đỏ (quá hạn, sai) */
  --color-danger: #ef4444;
  --color-danger-50: #fef2f2;
  --color-danger-100: #fee2e2;

  /* Bo góc & shadow thân thiện */
  --radius-xl: 1rem;
  --radius-2xl: 1.25rem;
  --radius-3xl: 1.75rem;

  /* Shadow có chiều sâu nhẹ */
  --shadow-soft: 0 2px 8px rgba(16, 24, 40, 0.06), 0 1px 2px rgba(16, 24, 40, 0.04);
  --shadow-card: 0 8px 24px rgba(16, 24, 40, 0.08);
  --shadow-lift: 0 18px 40px rgba(16, 24, 40, 0.12);

  --animate-pop: pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes pop {
  0% {
    transform: scale(0.85);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* ---------- Base ---------- */
html {
  scroll-behavior: smooth;
}

body {
  background-color: var(--color-cream);
  color: var(--color-ink);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
}

/* ---------- Tiện ích tùy chỉnh ---------- */
/* Ẩn thanh cuộn ngang (dùng cho thanh chip) */
.no-scrollbar::-webkit-scrollbar {
  display: none;
}
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* Perspective cho hiệu ứng lật flashcard 3D */
.perspective {
  perspective: 1600px;
}
.preserve-3d {
  transform-style: preserve-3d;
}
.backface-hidden {
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}
.rotate-y-180 {
  transform: rotateY(180deg);
}

/* Vết loang màu nền nhẹ cho hero */
.bg-grid {
  background-image: radial-gradient(circle at 1px 1px, rgba(37, 99, 235, 0.12) 1px, transparent 0);
  background-size: 28px 28px;
}
